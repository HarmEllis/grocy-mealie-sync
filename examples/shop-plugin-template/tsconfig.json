{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "types": ["node"], "erasableSyntaxOnly": true
  },
  "include": ["lib/**/*.ts", "src/**/*.ts"]
}
